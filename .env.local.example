# Copy this file to .env.local and fill in real values from your Supabase
# project's Settings -> API page. Never commit .env.local itself.

# Public (safe to expose to the browser): the anon, read-only key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: bypasses row-level security. Used only by the ingest job and by
# the Phase 2 database tests to set up/tear down test data — never used by
# the website, never committed, never pasted into chat.
SUPABASE_SERVICE_ROLE_KEY=
